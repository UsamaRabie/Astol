# ==============================================================================
# إعدادات بيئة مشروع أسطول (Astol Environment Configuration)
# ==============================================================================

# مفتاح الأمان لـ Django
SECRET_KEY=django-insecure-astol-production-fleet-secret-key-2026-secure-auth

# وضع التصحيح (True للتطوير، False للإنتاج)
DEBUG=True

# نوع قاعدة البيانات (Database Configuration: PostgreSQL)
# True  = استخدام خادم PostgreSQL المعتمد للمشروع (astol_fleet_db)
# False = استخدام قاعدة بيانات SQLite المحلية المدمجة (db.sqlite3)
USE_POSTGRESQL=True

# إعدادات PostgreSQL (PostgreSQL Connection Parameters)
DB_NAME=astol_fleet_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
