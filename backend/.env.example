# ==============================================================================
# Astol Fleet Management - Environment Variables Example (.env.example)
# ==============================================================================

SECRET_KEY=django-insecure-your-secret-key-here-fleet-management
DEBUG=True

# Database Configuration (PostgreSQL by default, or SQLite fallback)
USE_POSTGRESQL=True

# PostgreSQL Settings (When USE_POSTGRESQL=True)
DB_NAME=astol_fleet_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
